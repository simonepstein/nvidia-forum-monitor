# Copy to .env (gitignored) and fill in. Variables already exported in your
# environment take precedence over this file.

# GitHub fine-grained token: "Public repositories" read access, no permissions.
# Raises the API limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=

# Optional, Run C web search.
BRAVE_API_KEY=

# Optional, Run B local LLM endpoint key.
SPARKWATCH_LLM__API_KEY=
