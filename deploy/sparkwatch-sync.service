[Unit]
Description=sparkwatch forum sync and watched-repo check
Documentation=https://github.com/simon/dgx-spark-forum-monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/dev/nvidia-forum-monitor
ExecStart=%h/.local/bin/uv run sparkwatch sync
ExecStart=%h/.local/bin/uv run sparkwatch repos check
Nice=10
